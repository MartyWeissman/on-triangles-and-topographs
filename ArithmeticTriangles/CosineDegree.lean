module

public import ArithmeticTriangles.CyclotomicAction
public import ArithmeticTriangles.TraceBounds

/-!
# Individual cosine degrees and denominator restrictions

For n≥2, the single-generator field ℚ(2cos(π/n)) has degree φ(2n)/2.
Adjoining exp(πi/n) to its complex image gives the cyclotomic field and
has degree exactly two: the root satisfies X²−uX+1, and is nonreal.

A generator's field degree divides the triangle's full degree. Combined
with the even-conductor trace bounds, this bounds φ(2n) for each of the
three denominators. The full degree formula involving the gcd graph is
not needed for these individual restrictions and remains to be proved.
-/

@[expose] public section

open Polynomial

namespace ArithmeticTriangles

/-- The real field generated by one normalized cosine. -/
noncomputable def singleCosineField (n : ℕ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ {cosineGenerator n}

/-- A single algebraic generator gives a finite extension. -/
instance singleCosineField_finiteDimensional (n : ℕ) :
    FiniteDimensional ℚ (singleCosineField n) :=
  IntermediateField.adjoin.finiteDimensional (cosineGenerator_isIntegral_rat n)

/-- For n≥2, exp(πi/n) lies strictly above the real axis. -/
theorem cosineRoot_im_pos (n : ℕ) (hn : 2 ≤ n) : 0 < (cosineRoot n).im := by
  have hn' : (1 : ℝ) < n := by exact_mod_cast (show 1 < n by omega)
  have hp : 0 < Real.pi / n := div_pos Real.pi_pos (by linarith)
  have hlt : Real.pi / n < Real.pi := (div_lt_self Real.pi_pos hn')
  have he : cosineRoot n = Complex.exp (((Real.pi / n : ℝ) : ℂ) * Complex.I) := by
    simp [cosineRoot]
  rw [he, Complex.exp_ofReal_mul_I]
  simpa only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
    Complex.I_im, Complex.I_re, mul_one, mul_zero, add_zero, zero_add]
    using Real.sin_pos_of_pos_of_lt_pi hp hlt

/-- Twice the real cosine degree is the cyclotomic degree. Keeping the
formula multiplicative avoids natural-number division in the tower argument. -/
theorem singleCosineField_degree_twice (n : ℕ) (hn : 2 ≤ n) :
    2 * Module.finrank ℚ (singleCosineField n) = (2 * n).totient := by
  let : NeZero n := ⟨by omega⟩
  let f : ℝ →ₐ[ℚ] ℂ := IsScalarTower.toAlgHom ℚ ℝ ℂ
  -- Work inside ℂ so that the fields form a literal inclusion tower.
  let Cn := (singleCosineField n).map f
  let E := IntermediateField.adjoin Cn {cosineRoot n}
  have hCn : Cn = IntermediateField.adjoin ℚ {(cosineGenerator n : ℂ)} := by
    simp only [Cn, singleCosineField, IntermediateField.adjoin_map, Set.image_singleton]
    rfl
  have hle : Cn ≤ cosineCyclotomicField n := by
    rw [hCn]
    exact IntermediateField.adjoin_simple_le_iff.mpr (cosineGenerator_mem_adjoin_root n)
  have hE : E.restrictScalars ℚ = cosineCyclotomicField n := by
    rw [IntermediateField.restrictScalars_adjoin_eq_sup]
    exact sup_eq_right.mpr hle
  -- The primitive root is quadratic over the real cosine field.
  have hintQ : IsIntegral ℚ (cosineRoot n) :=
    ((cosineRoot_primitive n (by omega)).isIntegral (by omega)).tower_top
  have hint : IsIntegral Cn (cosineRoot n) := hintQ.tower_top
  let : FiniteDimensional Cn E := IntermediateField.adjoin.finiteDimensional hint
  let u : Cn := ⟨(cosineGenerator n : ℂ), by rw [hCn]; exact IntermediateField.mem_adjoin_simple_self _ _⟩
  let p : Cn[X] := C 1 * X ^ 2 + C (-u) * X + C 1
  have hdeg : p.natDegree = 2 := natDegree_quadratic one_ne_zero
  have hp : p ≠ 0 := by intro hz; simp [hz] at hdeg
  have hroot : p.aeval (cosineRoot n) = 0 := by
    simp only [p, map_add, map_mul, map_pow, aeval_C, aeval_X,
      map_one, map_neg, one_mul]
    change cosineRoot n ^ 2 + -(cosineGenerator n : ℂ) * cosineRoot n + 1 = 0
    rw [cosineGenerator_eq_root_add_inv]
    field_simp [show cosineRoot n ≠ 0 from Complex.exp_ne_zero _]
    ring
  have hupper : Module.finrank Cn E ≤ 2 := by
    rw [IntermediateField.adjoin.finrank hint]
    exact hdeg ▸ natDegree_le_of_dvd (minpoly.dvd Cn _ hroot) hp
  -- Degree one would place the nonreal root in a field of real numbers.
  have hne : Module.finrank Cn E ≠ 1 := by
    intro he
    have hbot := IntermediateField.finrank_adjoin_simple_eq_one_iff.mp he
    obtain ⟨x, hx⟩ := IntermediateField.mem_bot.mp hbot
    obtain ⟨y, _, hxy⟩ := (IntermediateField.mem_map _).mp x.property
    have hi := congrArg Complex.im hx
    have hxreal : (x : ℂ).im = 0 := by rw [← hxy]; rfl
    change (x : ℂ).im = (cosineRoot n).im at hi
    rw [hxreal] at hi
    exact (ne_of_gt (cosineRoot_im_pos n hn)) hi.symm
  have htwo : Module.finrank Cn E = 2 := by
    have := Module.finrank_pos (R := Cn) (M := E)
    omega
  -- Apply the tower law and transfer the complex image back to the real field.
  have htower := Module.finrank_mul_finrank ℚ Cn E
  have hc : Module.finrank ℚ Cn = Module.finrank ℚ (singleCosineField n) :=
    ((singleCosineField n).equivMap f).toLinearEquiv.finrank_eq.symm
  have heq : Module.finrank ℚ E = (2 * n).totient := by
    change Module.finrank ℚ (E.restrictScalars ℚ) = _
    rw [hE, cosineCyclotomicField_finrank]
  rw [htwo, hc, heq] at htower
  omega

/-- The usual degree formula for a single cosine, including n=2. -/
theorem singleCosineField_finrank (n : ℕ) (hn : 2 ≤ n) :
    Module.finrank ℚ (singleCosineField n) = (2 * n).totient / 2 := by
  have := singleCosineField_degree_twice n hn
  omega

namespace Triangle

/-- If the full cosine field contains uₙ, it contains the field generated by uₙ. -/
theorem singleCosineField_le (t : Triangle) (n : ℕ)
    (hmem : cosineGenerator n ∈ t.cosineField) : singleCosineField n ≤ t.cosineField :=
  IntermediateField.adjoin_simple_le_iff.mpr hmem

/-- The degree of any individual cosine generator divides the full degree.
This is stronger than a numerical upper bound. -/
theorem cosine_degree_dvd (t : Triangle) (n : ℕ) (hn : 2 ≤ n)
    (hmem : cosineGenerator n ∈ t.cosineField) : (2 * n).totient / 2 ∣ t.deg := by
  rw [← singleCosineField_finrank n hn]
  exact IntermediateField.finrank_dvd_of_le_right (t.singleCosineField_le n hmem)

/-- A useful division-free form of the individual degree bound. -/
theorem cosine_totient_le_twice_degree (t : Triangle) (n : ℕ) (hn : 2 ≤ n)
    (hmem : cosineGenerator n ∈ t.cosineField) : (2 * n).totient ≤ 2 * t.deg := by
  have hle := IntermediateField.finrank_le_of_le_right (t.singleCosineField_le n hmem)
  have heq := singleCosineField_degree_twice n hn
  change Module.finrank ℚ (singleCosineField n) ≤ t.deg at hle
  omega

/-- Package the bound for all three denominator positions. -/
theorem denominator_totients_le_twice_degree (t : Triangle) (h : t.Admissible) :
    (2 * t.e).totient ≤ 2 * t.deg ∧ (2 * t.f).totient ≤ 2 * t.deg ∧
      (2 * t.g).totient ≤ 2 * t.deg :=
  ⟨t.cosine_totient_le_twice_degree t.e h.1 t.firstGenerator.property,
    t.cosine_totient_le_twice_degree t.f (h.1.trans h.2.1) t.secondGenerator.property,
    t.cosine_totient_le_twice_degree t.g (h.1.trans (h.2.1.trans h.2.2))
      t.thirdGenerator.property⟩

/-- Lemma 2.3 now restricts each denominator: φ(2n)≤24 in the scalene even-N case. -/
theorem ArithmeticHyperbolic.denominator_totients_le_twenty_four {t : Triangle}
    (h : t.ArithmeticHyperbolic) (hs : t.Scalene) (he : 4 ≤ t.e)
    (hN : Even t.commonDenominator) :
    (2 * t.e).totient ≤ 24 ∧ (2 * t.f).totient ≤ 24 ∧ (2 * t.g).totient ≤ 24 := by
  have hd := h.deg_le_twelve_of_scalene_even hs he hN
  have ht := t.denominator_totients_le_twice_degree h.admissible
  omega

/-- At e=4, the sharper trace bound gives φ(2n)≤20 at all positions. -/
theorem ArithmeticHyperbolic.denominator_totients_le_twenty_of_first_four {t : Triangle}
    (h : t.ArithmeticHyperbolic) (hs : t.Scalene) (he : t.e = 4) :
    (2 * t.e).totient ≤ 20 ∧ (2 * t.f).totient ≤ 20 ∧ (2 * t.g).totient ≤ 20 := by
  have hd := h.deg_le_ten_of_first_four hs he
  have ht := t.denominator_totients_le_twice_degree h.admissible
  omega

end Triangle
end ArithmeticTriangles
