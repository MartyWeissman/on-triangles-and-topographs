module

public import ArithmeticTriangles.Algebraic
public import Mathlib.NumberTheory.Cyclotomic.Gal
public import Mathlib.RingTheory.RootsOfUnity.Complex

/-!
# An ambient cyclotomic field for the cosine generators

We make `2 cos(π/n) = ζ₂ₙ + ζ₂ₙ⁻¹` explicit and place all three generators
in `ℚ(ζ₂N)` for `N=lcm(e,f,g)`. Mathlib already provides the degree φ(2N)
and the Galois-group equivalence with units modulo 2N for this ambient field.

The action of restricted automorphisms is developed in `CyclotomicAction.lean`
and used for the structural inequality in `Structural.lean`.
`CyclotomicEmbeddings.lean` proves exhaustiveness and the identity criterion;
`CosineDegree.lean` computes individual cosine degrees. Counting the subgroup
fixing the full cosine field, and its degree formula, still require further work.
-/

@[expose] public section

namespace ArithmeticTriangles

/-- The concrete primitive `2n`-th root `exp(πi/n)` (primitive when `n ≠ 0`). -/
noncomputable def cosineRoot (n : ℕ) : ℂ := Complex.exp ((Real.pi : ℂ) / n * Complex.I)

/-- This is mathlib's primitive exponential root, with the exponent simplified. -/
theorem cosineRoot_primitive (n : ℕ) (hn : n ≠ 0) : IsPrimitiveRoot (cosineRoot n) (2 * n) := by
  have h := Complex.isPrimitiveRoot_exp (2 * n) (by omega)
  unfold cosineRoot
  convert h using 1
  congr 1
  push_cast
  ring

/-- Euler's formula connects our real generator to a cyclotomic expression. -/
theorem cosineGenerator_eq_root_add_inv (n : ℕ) :
    (cosineGenerator n : ℂ) = cosineRoot n + (cosineRoot n)⁻¹ := by
  unfold cosineGenerator cosineRoot
  push_cast
  rw [Complex.cos, mul_div_cancel₀ _ (by norm_num : (2 : ℂ) ≠ 0)]
  rw [← Complex.exp_neg]
  simp only [neg_mul]

/-- The individual cosine generator belongs to its cyclotomic field. -/
theorem cosineGenerator_mem_adjoin_root (n : ℕ) :
    (cosineGenerator n : ℂ) ∈ IntermediateField.adjoin ℚ ({cosineRoot n} : Set ℂ) := by
  have hζ : cosineRoot n ∈ IntermediateField.adjoin ℚ ({cosineRoot n} : Set ℂ) :=
    IntermediateField.subset_adjoin ℚ _ (by simp)
  rw [cosineGenerator_eq_root_add_inv]
  exact (IntermediateField.adjoin ℚ ({cosineRoot n} : Set ℂ)).add_mem hζ
    ((IntermediateField.adjoin ℚ ({cosineRoot n} : Set ℂ)).inv_mem hζ)

/-- An ambient cyclotomic field inside ℂ, generated by a root of order `2n`.
This is generally larger than the real cosine field; no assertion about the
minimal conductor is made here. -/
noncomputable def cosineCyclotomicField (n : ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ {cosineRoot n}

/-- Register the concrete adjoined field with mathlib's cyclotomic interface. -/
instance cosineCyclotomicField_isCyclotomic (n : ℕ) [NeZero n] :
    IsCyclotomicExtension {2 * n} ℚ (cosineCyclotomicField n) := by
  have hζ := cosineRoot_primitive n (NeZero.ne n)
  change IsCyclotomicExtension {2 * n} ℚ (IntermediateField.adjoin ℚ {cosineRoot n}).toSubalgebra
  have hint : IsIntegral ℚ (cosineRoot n) :=
    (hζ.isIntegral (by have := NeZero.pos n; omega)).tower_top
  rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic]
  exact hζ.adjoin_isCyclotomicExtension ℚ

/-- Register finite dimensionality so trace constructions can use the ambient field. -/
instance cosineCyclotomicField_finiteDimensional (N : ℕ) [NeZero N] :
    FiniteDimensional ℚ (cosineCyclotomicField N) :=
  IsCyclotomicExtension.finiteDimensional {2 * N} ℚ _

/-- Mathlib's Galois-group theorem specialized to our ambient field:
`Gal(ℚ(ζ₂ₙ)/ℚ) ≃ (ℤ/2nℤ)ˣ`. The restricted action is developed in `CyclotomicAction.lean`. -/
noncomputable def cosineCyclotomicGaloisEquiv (n : ℕ) [NeZero n] :
    (cosineCyclotomicField n ≃ₐ[ℚ] cosineCyclotomicField n) ≃* (ZMod (2 * n))ˣ :=
  IsCyclotomicExtension.autEquivPow _
    (Polynomial.cyclotomic.irreducible_rat (by have := NeZero.pos n; omega))

/-- The ambient cyclotomic degree is φ(2n); this is not the cosine-field degree. -/
theorem cosineCyclotomicField_finrank (n : ℕ) [NeZero n] :
    Module.finrank ℚ (cosineCyclotomicField n) = (2 * n).totient :=
  IsCyclotomicExtension.finrank _
    (Polynomial.cyclotomic.irreducible_rat (by have := NeZero.pos n; omega))

/-- Compatibility of the chosen roots when one denominator divides another. -/
theorem cosineRoot_pow_mul (n k : ℕ) (hn : n ≠ 0) (hk : k ≠ 0) :
    cosineRoot (n * k) ^ k = cosineRoot n := by
  unfold cosineRoot
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  field_simp

/-- All denominators dividing `N` give generators in the same cyclotomic field. -/
theorem cosineGenerator_mem_cyclotomic_of_dvd (n N : ℕ) (hN : N ≠ 0) (hdvd : n ∣ N) :
    (cosineGenerator n : ℂ) ∈ cosineCyclotomicField N := by
  obtain ⟨k, rfl⟩ := hdvd
  have hn : n ≠ 0 := by aesop
  have hk : k ≠ 0 := by aesop
  have hζ : cosineRoot n ∈ cosineCyclotomicField (n * k) := by
    rw [← cosineRoot_pow_mul n k hn hk]
    exact (cosineCyclotomicField (n * k)).pow_mem
      (IntermediateField.subset_adjoin ℚ _ (by simp)) k
  rw [cosineGenerator_eq_root_add_inv]
  exact (cosineCyclotomicField (n * k)).add_mem hζ
    ((cosineCyclotomicField (n * k)).inv_mem hζ)

namespace Triangle

/-- The integer `N = lcm(e,f,g)` used in the PDF. -/
def commonDenominator (triangle : Triangle) : ℕ := triangle.e.lcm (triangle.f.lcm triangle.g)

theorem commonDenominator_ne_zero (triangle : Triangle) (h : triangle.Admissible) :
    triangle.commonDenominator ≠ 0 := by
  apply Nat.lcm_ne_zero (by have := h.1; omega)
  exact Nat.lcm_ne_zero (by have := h.1; have := h.2.1; omega)
    (by have := h.1; have := h.2.1; have := h.2.2; omega)

/-- After including ℝ into ℂ, the entire cosine field lies in `ℚ(ζ₂N)`.
The proof checks the three generators, then uses the universal property of adjoin. -/
theorem cosineField_map_le_cyclotomic (triangle : Triangle) (h : triangle.Admissible) :
    triangle.cosineField.map (IsScalarTower.toAlgHom ℚ ℝ ℂ) ≤
      cosineCyclotomicField triangle.commonDenominator := by
  rw [IntermediateField.map_le_iff_le_comap]
  apply IntermediateField.adjoin_le_iff.mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · exact cosineGenerator_mem_cyclotomic_of_dvd _ _ (triangle.commonDenominator_ne_zero h)
      (Nat.dvd_lcm_left _ _)
  · exact cosineGenerator_mem_cyclotomic_of_dvd _ _ (triangle.commonDenominator_ne_zero h)
      ((Nat.dvd_lcm_left _ _).trans (Nat.dvd_lcm_right _ _))
  · exact cosineGenerator_mem_cyclotomic_of_dvd _ _ (triangle.commonDenominator_ne_zero h)
      ((Nat.dvd_lcm_right _ _).trans (Nat.dvd_lcm_right _ _))

end Triangle
end ArithmeticTriangles
